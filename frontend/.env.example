# Wonderland frontend – copy to .env.local on the laptop (docs/05 section 3).
# In AWS Amplify these are set as environment variables instead.

# Empty on the laptop = use the Vite dev proxy. In Amplify: the API Gateway URL (no trailing slash).
VITE_API_BASE_URL=

# local = role switcher with X-Local-User headers. cognito = Amplify Authenticator with real Cognito login.
VITE_AUTH_MODE=local

# Needed only when VITE_AUTH_MODE=cognito (values from the Cognito stack outputs).
VITE_AWS_REGION=
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# "Open Metabase dashboard" button on the admin monitoring page (port-forward URL).
VITE_METABASE_URL=http://localhost:3000
