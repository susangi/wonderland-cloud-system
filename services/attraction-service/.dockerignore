# Packages are installed inside the image, so the laptop copies are not needed.
vendor
node_modules
# Secrets never go into an image. Values come from env variables at run time.
.env
.env.*
!.env.example
# Not needed to run the service.
tests
storage/logs/*
.phpunit.result.cache
.git

# Laravel cache files made on the laptop list dev packages too.
# Leave them out, so Laravel builds fresh ones inside the container.
bootstrap/cache/*.php