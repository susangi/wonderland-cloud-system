# payment-service – local development values (docs/05-local-development.md).
# Copy to .env. In Kubernetes these come from the ConfigMap and Secrets instead.

APP_NAME=payment-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8004

# Use stderr in production so logs go to CloudWatch.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=payment_db
DB_USERNAME=root
DB_PASSWORD=root

# Stateless: no sessions on disk, cache shared through the database.
SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync

# local = X-Local-User / X-Local-Groups headers (only with APP_ENV=local). cognito = real tokens.
AUTH_MODE=local
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

INTERNAL_TOKEN=local-internal-token

# Mock payment demo switches (design 6.4)
PAYMENT_SIMULATE_DOWN=false
PAYMENT_DELAY_MS=0
